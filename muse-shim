#!/usr/bin/env sh
# Legacy low-level server entry point; arguments pass to muse_gateway.py.
# Prefer ./muse-gateway for the subscription launcher, or use this script's
# `launch` subcommand explicitly. The historical default stays server-only.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$script_dir/.venv/bin/python" ]; then
  exec "$script_dir/.venv/bin/python" "$script_dir/muse_gateway.py" "$@"
fi
exec python3 "$script_dir/muse_gateway.py" "$@"
