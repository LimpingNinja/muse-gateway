+class TestKiroHttpClientExtraHeaders:
+    """Management headers are local to a request, including token-refresh retries."""
+
+    @pytest.mark.asyncio
+    async def test_management_retry_retains_auth_and_does_not_change_inference(self, mock_auth_manager_for_http: Mock) -> None:
+        """Send management then inference through the real HTTP client's public API."""
+        auth = mock_auth_manager_for_http
+        auth.get_access_token.side_effect = ["expired", "refreshed", "refreshed"]
+        transport = AsyncMock()
+        transport.request.side_effect = [
+            httpx.Response(403), httpx.Response(200), httpx.Response(200),
+        ]
+        http_client = KiroHttpClient(auth, shared_client=transport)
+        headers = {
+            "Content-Type": "application/x-amz-json-1.0",
+            "x-amz-target": "AmazonCodeWhispererService.ListAvailableModels",
+        }
+        response = await http_client.request_with_retry(
+            "POST", "https://management.eu-central-1.kiro.dev/",
+            json_data={"origin": "AI_EDITOR"}, extra_headers=headers,
+        )
+        assert response.status_code == 200
+        auth.force_refresh.assert_awaited_once()
+        await http_client.request_with_retry(
+            "POST", "https://runtime.eu-central-1.kiro.dev/generateAssistantResponse",
+            json_data={"conversationState": {}},
+        )
+        calls = transport.request.await_args_list
+        assert len(calls) == 3
+        for i, token in enumerate(["expired", "refreshed"]):
+            sent = calls[i].kwargs
+            assert calls[i].args == ("POST", "https://management.eu-central-1.kiro.dev/")
+            assert json.loads(sent["content"]) == {"origin": "AI_EDITOR"}
+            assert "params" not in sent
+            assert sent["headers"]["Authorization"] == f"Bearer {token}"
+            assert sent["headers"]["x-amz-target"] == headers["x-amz-target"]
+            assert sent["headers"]["Content-Type"] == headers["Content-Type"]
+            assert "User-Agent" in sent["headers"]
+        assert calls[2].kwargs["headers"]["x-amz-target"] == \
+            "AmazonCodeWhispererStreamingService.GenerateAssistantResponse"
+        assert calls[2].kwargs["headers"]["Authorization"] == "Bearer refreshed"
+        assert headers == {
+            "Content-Type": "application/x-amz-json-1.0",
+            "x-amz-target": "AmazonCodeWhispererService.ListAvailableModels",
+        }
