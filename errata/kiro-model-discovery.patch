+class TestNativeModelDiscovery:
+    """Model discovery must populate startup and TTL caches without partial data."""
+
+    @pytest.mark.asyncio
+    async def test_runtime_initialization_and_ttl_refresh(self) -> None:
+        """The real caller discovers new models at startup and after TTL expiry."""
+        import hashlib
+        profile = "arn:aws:codewhisperer:eu-central-1:123:profile/test"
+        auth = KiroAuthManager(
+            refresh_token="test-refresh", profile_arn=profile,
+            region="us-west-2", api_region="eu-central-1",
+        )
+        original_hosts = (auth.api_host, auth.q_host)
+        account_id = "refresh_token_" + hashlib.sha256(b"test-refresh").hexdigest()[:16]
+        manager = AccountManager("unused-credentials.json", "unused-state.json")
+        manager._credentials_config = [{"type": "refresh_token", "refresh_token": "test-refresh"}]
+        manager._accounts[account_id] = Account(id=account_id)
+        first = {"modelId": "catalog-new", "tokenLimits": {"maxInputTokens": 123456},
+                 "additionalModelRequestFieldsSchema": {"type": "object"}}
+        second = {"modelId": "catalog-newer", "displayName": "Newer model"}
+        client = AsyncMock()
+        client.request_with_retry.side_effect = [
+            httpx.Response(200, json={"models": [first]}),
+            httpx.Response(200, json={"models": [second]}),
+        ]
+        with patch("kiro.account_manager.KiroAuthManager", return_value=auth), \
+             patch.object(auth, "get_access_token", new=AsyncMock(return_value="test-access")), \
+             patch("kiro.account_manager.KiroHttpClient", return_value=client):
+            account = await manager.get_next_account("catalog-new")
+            assert account is not None and account.model_cache is not None
+            assert account.model_cache.get("catalog-new") == first
+            assert "catalog-new" in manager.get_all_available_models()
+            account.models_cached_at = 1
+            assert await manager.get_next_account("catalog-newer") is account
+        assert account.model_cache.get("catalog-newer") == second
+        assert account.model_cache.get("catalog-new") is None
+        assert account.models_cached_at > 1
+        assert "catalog-newer" in manager.get_all_available_models()
+        assert (auth.api_host, auth.q_host) == original_hosts
+        body = {"origin": "AI_EDITOR"}
+        if profile:
+            body["profileArn"] = profile
+        assert client.request_with_retry.await_count == 2
+        for call in client.request_with_retry.await_args_list:
+            assert call.kwargs == {
+                "method": "POST", "url": "https://management.eu-central-1.kiro.dev/",
+                "json_data": body, "stream": False,
+                "extra_headers": {"Content-Type": "application/x-amz-json-1.0",
+                                  "x-amz-target": "AmazonCodeWhispererService.ListAvailableModels"},
+            }
+        assert client.close.await_count == 2
+
+    @pytest.mark.asyncio
+    async def test_incomplete_catalog_falls_back_then_preserves_stale_cache(self) -> None:
+        """Never install a partial catalog, even if some records look valid."""
+        import hashlib
+        auth = KiroAuthManager(refresh_token="test-refresh", api_region="eu-central-1")
+        account_id = "refresh_token_" + hashlib.sha256(b"test-refresh").hexdigest()[:16]
+        manager = AccountManager("unused-credentials.json", "unused-state.json")
+        manager._credentials_config = [{"type": "refresh_token", "refresh_token": "test-refresh"}]
+        manager._accounts[account_id] = Account(id=account_id)
+        client = AsyncMock()
+        client.request_with_retry.return_value = httpx.Response(
+            200, json={"models": [{"modelId": "partial"}], "nextToken": "page-2"},
+        )
+        with patch("kiro.account_manager.KiroAuthManager", return_value=auth), \
+             patch.object(auth, "get_access_token", new=AsyncMock(return_value="test-access")), \
+             patch("kiro.account_manager.KiroHttpClient", return_value=client), \
+             patch("kiro.account_manager.logger") as log:
+            account = await manager.get_next_account("any-model")
+            assert account is not None and account.model_cache is not None
+            assert set(m["modelId"] for m in FALLBACK_MODELS) <= set(account.model_cache.get_all_model_ids())
+            assert any("Using pre-configured fallback models" in str(c) for c in log.warning.call_args_list)
+            stale = {"modelId": "known-good", "tokenLimits": {"maxInputTokens": 654321}}
+            await account.model_cache.update([stale])
+            account.models_cached_at = 1
+            cache_time = account.model_cache.last_update_time
+            manager._dirty = False
+            assert await manager.get_next_account("known-good") is account
+            assert account.model_cache.get_all_model_ids() == ["known-good"]
+            assert account.model_cache.get("known-good") == stale
+            assert account.models_cached_at == 1
+            assert account.model_cache.last_update_time == cache_time
+            assert manager._dirty is False
+            assert any("Failed to refresh models" in str(c) for c in log.warning.call_args_list)
+        assert client.request_with_retry.await_count == 2
+        assert client.close.await_count == 2
