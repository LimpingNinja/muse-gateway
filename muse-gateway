#!/usr/bin/env bash
# One-shot launcher: starts the muse-gateway, then Muse on top of it.
#
# Thin wrapper around `python muse_gateway.py launch` (same as the installed
# `muse-gateway launch` command). All arguments forward unchanged: launcher
# options (--port, --check-only, --local-*) come first, then Muse subcommands
# (resume, exec), flags (--model, --yolo), and --help, which passes through
# to `muse`. Your working directory is preserved for the Muse process.
# If the port already serves a compatible gateway (e.g. from another
# terminal), Muse attaches to it instead of starting a new one.
#
# Meta models ride your `muse login` subscription (OAuth) via header
# forwarding, so no Meta API key is configured. Codex uses your existing
# `codex login`. Install once with `python3 -m pip install .` from the checkout;
# protobuf is installed with the package. A virtual environment is optional.
# Local-backend config comes from flags, environment
# (MUSE_GATEWAY_LOCAL_UPSTREAM, MUSE_GATEWAY_LOCAL_API_KEY,
# MUSE_GATEWAY_LOCAL_MODELS; the MUSE_SHIM_* spellings still work), or a
# `.env` file next to this script; flags win over env, env wins over
# the file. Run with -h for launcher help.
#
#   ./muse-gateway                                   # interactive Muse on :8787
#   ./muse-gateway resume <session-id>               # resume a session
#   ./muse-gateway --check-only                      # validate, no Muse launch
#   ./muse-gateway --port 9000                       # custom port
#
# --check-only checks startup and the catalog, not inference. Headless `exec`
# arguments pass to Muse, whose model-profile/compaction rules still apply.
#
# For Meta API-key billing, use the manual server setup in README.md instead
# of this subscription-authentication launcher.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "error: python3/python not found on PATH" >&2
  exit 1
fi

exec "$PYTHON" "$SCRIPT_DIR/muse_gateway.py" launch --env-file "$SCRIPT_DIR/.env" "$@"
