# muse-gateway local backend config.
# Copy to .env (same folder as the launcher scripts) and fill in.
# .env is ignored; never commit real keys.
# The older MUSE_SHIM_* spellings below still work as fallbacks.

# LiteLLM (or any OpenAI-style Responses) base URL.
MUSE_GATEWAY_LOCAL_UPSTREAM=http://127.0.0.1:4000/v1

# Optional for gateway startup; required by the launcher to enable local preflight.
# Leave blank to use Muse/Codex/Claude without configuring a local backend.
MUSE_GATEWAY_LOCAL_API_KEY=

# Optional: comma-separated aliases to advertise as local/ entries.
# When unset, the gateway lists <upstream>/models automatically.
MUSE_GATEWAY_LOCAL_MODELS=

# Devin (Codeium Cascade) provider.
# Credentials: an explicit session token below, else your Devin CLI login
# (`devin auth login`), else your OMP login (~/.omp/agent/agent.db).
# There is no refresh grant: an expired login means logging in again.
# MUSE_GATEWAY_DEVIN_API_KEY=
# MUSE_GATEWAY_DEVIN_AUTH_DB=
# MUSE_GATEWAY_DEVIN_CREDENTIAL_ID=
# MUSE_GATEWAY_DEVIN_UPSTREAM=https://server.codeium.com
# MUSE_GATEWAY_DEVIN_MODELS=
# Opt-in private captures; contains conversation content. Keep unset normally.
# MUSE_GATEWAY_CAPTURE_DIR=/path/outside/the/repository
