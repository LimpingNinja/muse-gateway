# muse-gateway configuration. Uncomment only the settings you need.
# Copy to a private .env; do not commit real keys or credential paths.
# Source wrappers read .env beside the scripts. The installed launch command
# can read another file with: --env-file /path/to/.env
# Flags override environment values; nonempty environment values override
# the same names in this file. Legacy MUSE_SHIM_* names remain fallbacks.

# The normal launcher uses `muse login` for Meta subscription authentication.
# Do not set a Meta API key here for that workflow. See README.md for manual
# server setup if you want Meta API-key billing instead.

# Listener and diagnostics. Log/capture parent directories must be writable.
# MUSE_GATEWAY_PORT=8787
# MUSE_GATEWAY_LOG_FILE=/path/to/muse-gateway.log

# Local LLM / LiteLLM / other Responses endpoint.
# Requires OpenAI Responses, not just Chat Completions. Leave these commented
# to keep local/ entries disabled. /models supplies IDs unless you set a list.
# A route key enables launcher preflight and avoids forwarding Muse's bearer.
# Without a key, preflight is skipped but explicit local settings stay active.
# MUSE_GATEWAY_LOCAL_UPSTREAM=http://127.0.0.1:4000/v1
# MUSE_GATEWAY_LOCAL_API_KEY=replace-with-your-upstream-key
# MUSE_GATEWAY_LOCAL_MODELS=my-coder,my-reasoner

# Codex: uses `codex login` credentials; CLI is not used for inference.
# Optional credential file override (otherwise normal Codex discovery).
# MUSE_GATEWAY_CODEX_AUTH=/path/to/codex/auth.json
# MUSE_GATEWAY_CODEX_MODELS=

# Claude: uses the installed, signed-in `claude -p` by default.
# HTTP mode uses Anthropic Messages and separate credential discovery.
# MUSE_GATEWAY_CLAUDE_TRANSPORT=cli
# MUSE_GATEWAY_CLAUDE_CLI=claude
# MUSE_GATEWAY_CLAUDE_MODELS=
# MUSE_GATEWAY_CLAUDE_CREDENTIALS=/path/to/claude/credentials.json

# Devin (Codeium Cascade) provider.
# Credentials: an explicit session token below, else your Devin CLI login
# (`devin auth login`), else your OMP login (~/.omp/agent/agent.db).
# There is no refresh grant: an expired login means logging in again.
# MUSE_GATEWAY_DEVIN_API_KEY=
# MUSE_GATEWAY_DEVIN_AUTH_DB=
# MUSE_GATEWAY_DEVIN_CREDENTIAL_ID=
# MUSE_GATEWAY_DEVIN_UPSTREAM=https://server.codeium.com
# MUSE_GATEWAY_DEVIN_MODELS=

# Kiro Gateway: optional, separately installed/authenticated Messages service.
# This is its proxy API key, not a Muse/Claude key or native Kiro login token.
# No credential fallback; leave these commented to keep the route disabled.
# The launcher requires a FREE port when Kiro is configured (e.g. --port 8791).
# MUSE_GATEWAY_KIRO_UPSTREAM=http://127.0.0.1:8000/v1
# MUSE_GATEWAY_KIRO_API_KEY=replace-with-your-kiro-gateway-proxy-key
# MUSE_GATEWAY_KIRO_MODELS=claude-sonnet-4.5
# Positive UNVERIFIED planning hints for Muse; NOT backend-enforced limits.
# MUSE_GATEWAY_KIRO_CONTEXT_LIMIT=65536
# MUSE_GATEWAY_KIRO_OUTPUT_LIMIT=8192
# In Kiro Gateway's OWN config, recommend FAKE_REASONING=false,
# WEB_SEARCH_ENABLED=false, TRUNCATION_RECOVERY=false, AUTO_TRIM_PAYLOAD=false.
# Those are separate-service settings, not MUSE_GATEWAY_* options.

# Discovery and output controls.
# MUSE_GATEWAY_NO_MODEL_DISCOVERY=1
# MUSE_GATEWAY_MAX_OUTPUT_TOKENS=32768
# MUSE_GATEWAY_TIMEOUT=600

# Opt-in private captures; contains conversation content. Keep unset normally.
# MUSE_GATEWAY_CAPTURE_DIR=/path/outside/the/repository
